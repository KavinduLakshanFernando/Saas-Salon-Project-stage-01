# Next.js Port
PORT=3002

# Internal URL used by Server Components to communicate with NestJS backend
INTERNAL_API_URL=http://localhost:3000

# Public URL used in browser / client-side
NEXT_PUBLIC_API_URL=http://localhost:3000

# Primary SaaS platform domain for subdomain routing (e.g. dartsalon.com)
PLATFORM_DOMAIN=localhost

