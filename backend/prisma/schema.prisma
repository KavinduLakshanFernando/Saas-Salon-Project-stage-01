model SmsPackage {
  id           String                 @id @default(uuid()) @db.Uuid
  name         String
  credits      Int
  price        Decimal                @db.Decimal(10, 2)
  currency     String                 @default("LKR")
  description  String?
  isActive     Boolean                @default(true) @map("is_active")
  displayOrder Int                    @default(0) @map("display_order")
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")
  transactions SmsCreditTransaction[]
  rechargeRequests SmsRechargeRequest[]

  @@index([isActive])
  @@index([displayOrder])
  @@map("sms_packages")
}

model TenantSmsWallet {
  id                    String    @id @default(uuid()) @db.Uuid
  tenantId              String    @unique @map("tenant_id") @db.Uuid
  balance               Int       @default(0)
  totalPurchased        Int       @default(0) @map("total_purchased")
  totalConsumed         Int       @default(0) @map("total_consumed")
  lowBalanceThreshold   Int       @default(20) @map("low_balance_threshold")
  lowBalanceWarned      Boolean   @default(false) @map("low_balance_warned")
  isActive              Boolean   @default(false) @map("is_active")
  activatedAt           DateTime? @map("activated_at")
  initialBonusGranted   Boolean   @default(false) @map("initial_bonus_granted")
  initialBonusGrantedAt DateTime? @map("initial_bonus_granted_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  tenant                Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([isActive])
  @@map("tenant_sms_wallets")
}

enum SmsCreditTransactionType {
  PURCHASE
  USAGE
  REFUND
  ADJUSTMENT
  INITIAL_BONUS
}

model SmsCreditTransaction {
  id             String                   @id @default(uuid()) @db.Uuid
  tenantId       String                   @map("tenant_id") @db.Uuid
  type           SmsCreditTransactionType
  amount         Int
  balanceAfter   Int                      @map("balance_after")
  reference      String?
  paymentOrderId String?                  @map("payment_order_id") @db.Uuid
  packageId      String?                  @map("package_id") @db.Uuid
  description    String?
  metadata       Json?
  createdAt      DateTime                 @default(now()) @map("created_at")
  package        SmsPackage?              @relation(fields: [packageId], references: [id], onDelete: SetNull)
  paymentOrder   PaymentOrder?            @relation(fields: [paymentOrderId], references: [id], onDelete: SetNull)
  tenant         Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  manualPayment  SmsManualPayment?
  rechargeRequest SmsRechargeRequest?

  @@index([tenantId])
  @@index([type])
  @@index([createdAt])
  @@map("sms_credit_transactions")
}

