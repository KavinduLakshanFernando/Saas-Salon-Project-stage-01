model SmsRechargeRequest {
  id                  String                   @id @default(uuid()) @db.Uuid
  tenantId            String                   @map("tenant_id") @db.Uuid
  packageId           String?                  @map("package_id") @db.Uuid
  requestedCredits    Int                      @map("requested_credits")
  amount              Decimal?                 @db.Decimal(10, 2)
  ownerMessage        String?                  @map("owner_message")
  status              SmsRechargeRequestStatus @default(PENDING)
  adminNotes          String?                  @map("admin_notes")
  actionedByAdminId   String?                  @map("actioned_by_admin_id") @db.Uuid
  creditTransactionId String?                  @unique @map("credit_transaction_id") @db.Uuid
  fulfilledAt         DateTime?                @map("fulfilled_at")
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")
  tenant              Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  package             SmsPackage?              @relation(fields: [packageId], references: [id], onDelete: SetNull)
  actionedBy          SuperAdminUser?          @relation("AdminActionedRequests", fields: [actionedByAdminId], references: [id], onDelete: SetNull)
  creditTransaction   SmsCreditTransaction?    @relation(fields: [creditTransactionId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
  @@index([actionedByAdminId])
  @@map("sms_recharge_requests")
}

enum WebsiteStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model SalonWebsite {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @unique @map("tenant_id") @db.Uuid
  schemaName     String        @map("tenant_schema") @db.VarChar(63)
  subdomain      String        @unique @db.VarChar(63)
  customDomain   String?       @unique @map("custom_domain") @db.VarChar(255)
  title          String        @db.VarChar(255)
  tagline        String?       @db.VarChar(255)
  description    String?       @db.Text
  themeColor     String?       @default("#7C3AED") @map("theme_color") @db.VarChar(32)
  logoUrl        String?       @map("logo_url") @db.Text
  bannerUrl      String?       @map("banner_url") @db.Text
  status         WebsiteStatus @default(DRAFT)
  isPublished    Boolean       @default(false) @map("is_published")
  contactPhone   String?       @map("contact_phone") @db.VarChar(50)
  contactEmail   String?       @map("contact_email") @db.VarChar(255)
  address        String?       @db.Text
  socialLinks    Json?         @map("social_links")
  seoTitle       String?       @map("seo_title") @db.VarChar(255)
  seoDescription String?       @map("seo_description") @db.Text
  seoKeywords    String?       @map("seo_keywords") @db.VarChar(255)
  ogImageUrl     String?       @map("og_image_url") @db.Text
  templateId     String        @default("modern-beauty") @map("template_id") @db.VarChar(63)
  draftContent   Json?         @map("draft_content")
  publishedContent Json?       @map("published_content")
  publishedAt    DateTime?     @map("published_at")
  previewToken   String?       @map("preview_token") @db.VarChar(128)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([subdomain])
  @@index([customDomain])
  @@map("salon_websites")
}

