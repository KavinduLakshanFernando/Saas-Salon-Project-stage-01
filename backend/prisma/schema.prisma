model SmsManualPayment {
  id                  String                @id @default(uuid()) @db.Uuid
  tenantId            String                @map("tenant_id") @db.Uuid
  amount              Decimal               @db.Decimal(10, 2)
  credits             Int
  paymentMethod       SmsPaymentMethod      @default(BANK_TRANSFER) @map("payment_method")
  paymentReference    String                @map("payment_reference")
  paymentDate         DateTime              @map("payment_date")
  confirmedByAdminId  String                @map("confirmed_by_admin_id") @db.Uuid
  notes               String?
  creditTransactionId String?               @unique @map("credit_transaction_id") @db.Uuid
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")
  tenant              Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  confirmedBy         SuperAdminUser        @relation(fields: [confirmedByAdminId], references: [id], onDelete: Cascade)
  creditTransaction   SmsCreditTransaction? @relation(fields: [creditTransactionId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([confirmedByAdminId])
  @@index([paymentReference])
  @@index([createdAt])
  @@map("sms_manual_payments")
}

